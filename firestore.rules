rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 7.5: Canonical User Profile Document
    // Security Rule: Restricted strictly to the authenticated user owning the document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Phase 8.1: Meal / Scan History Subcollection
      // Security Rule: Restricted strictly to the authenticated owner.
      match /meals/{mealId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Phase 8.7: Hydration Subcollection
      // Security Rule: Restricted strictly to the authenticated owner.
      match /hydration/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
