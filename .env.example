# Track-a-Bite Production Environment Variables Template
# Copy this file to .env.local and configure your environment-specific credentials.

# ---------------------------------------------------------------------------
# Server-Side Secrets (NEVER expose to client with NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------------
# Google Gemini API Key for server-side AI food recognition & Google Search Grounding
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Application base canonical URL (used for metadata, open graph & sitemap)
NEXT_PUBLIC_APP_URL=https://track-a-bite.vercel.app

# ---------------------------------------------------------------------------
# Firebase Client Configuration (Public configuration identifiers for Web SDK)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
